# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime digests (seed may be committed optionally)
# keep structure; ignore churn if desired — we commit latest for demo
# /data/latest-digest.json
# /data/history/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
