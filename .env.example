# Optional LLM — leave empty / unset to use free heuristic writer.
# Prefer the /settings page in the UI; it writes data/settings.json + .env.local.
# LLM_ENABLED=true
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# Gemini (OpenAI-compatible):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# Ollama (local):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_TIMEOUT_MS=90000
